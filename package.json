{
  "name": "redux-like-middleware-for-usereducer",
  "version": "1.0.0",
  "description": "Redux-style middleware for React's useReducer hook.",
  "keywords": [
    "react",
    "hook",
    "usereducer",
    "middleware",
    "redux"
  ],
  "author": "sinelanguage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinelanguage/redux-like-middleware-for-useReducer.git"
  },
  "bugs": {
    "url": "https://github.com/sinelanguage/redux-like-middleware-for-useReducer/issues"
  },
  "homepage": "https://github.com/sinelanguage/redux-like-middleware-for-useReducer#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
